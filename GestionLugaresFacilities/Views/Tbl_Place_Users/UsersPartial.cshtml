@model IEnumerable<GestionLugaresFacilities.Models.Tbl_Place_Users>

<link rel="stylesheet" href="~/Content/btnAdd.css" />
<link rel="stylesheet" href="~/Content/btnEdit.css" />
<link rel="stylesheet" href="~/Content/btnDel.css" />

<h2 style="text-align:center">Usuarios</h2>
<section class="container-usuarios">
    <button class="Btnnn" onclick="addUserPartial()">

        <div class="signnn">+</div>

        <div class="texttt">Crear</div>
    </button>
    <br />

    <table>
        <thead>
            <tr class="tbl-users-head">
                <th>
                    @Html.DisplayNameFor(model => model.id_employee)
                </th>
                @*<th>
                    @Html.DisplayNameFor(model => model.name_employee)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.lastname)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ibt)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.position)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.supervisor)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.email)
                </th>*@
                <th>
                    @Html.DisplayNameFor(model => model.Tbl_Place_UserRoles.rol)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Tbl_Place_UserStatus.statusU)
                </th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {

                <tr class="tbl-body-usersP">
                    <td>
                        @Html.DisplayFor(modelItem => item.id_employee)
                    </td>
                    @*<td>
                        @Html.DisplayFor(modelItem => item.name_employee)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.lastname)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ibt)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.position)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.supervisor)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.email)
                    </td>*@
                    <td>
                        @Html.DisplayFor(modelItem => item.Tbl_Place_UserRoles.rol)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Tbl_Place_UserStatus.statusU)
                    </td>
                    <td class="btnsUD">
                        <button class="edit-button" onclick="editUserPartial(@item.id_users)">
                            <svg class="edit-svgIcon" viewBox="0 0 512 512">
                                <path d="M410.3 231l11.3-11.3-33.9-33.9-62.1-62.1L291.7 89.8l-11.3 11.3-22.6 22.6L58.6 322.9c-10.4 10.4-18 23.3-22.2 37.4L1 480.7c-2.5 8.4-.2 17.5 6.1 23.7s15.3 8.5 23.7 6.1l120.3-35.4c14.1-4.2 27-11.8 37.4-22.2L387.7 253.7 410.3 231zM160 399.4l-9.1 22.7c-4 3.1-8.5 5.4-13.3 6.9L59.4 452l23-78.1c1.4-4.9 3.8-9.4 6.9-13.3l22.7-9.1v32c0 8.8 7.2 16 16 16h32zM362.7 18.7L348.3 33.2 325.7 55.8 314.3 67.1l33.9 33.9 62.1 62.1 33.9 33.9 11.3-11.3 22.6-22.6 14.5-14.5c25-25 25-65.5 0-90.5L453.3 18.7c-25-25-65.5-25-90.5 0zm-47.4 168l-144 144c-6.2 6.2-16.4 6.2-22.6 0s-6.2-16.4 0-22.6l144-144c6.2-6.2 16.4-6.2 22.6 0s6.2 16.4 0 22.6z"></path>
                            </svg>
                        </button>

                        <button class="delete-button" onclick="deleteUserPartial(@item.id_users)">
                            <svg class="delete-svgIcon" viewBox="0 0 448 512">
                                <path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"></path>
                            </svg>
                        </button>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</section>
<style>
    .btnsUD {
        display: flex;
        align-content: flex-start;
    }
    .container-usuarios {
        width: 100%;
        margin-top: 7px;
        border-top: 1px solid #ddd; /* Borde inferior para las filas */
        border-bottom: 1px solid #ddd; /* Borde inferior para las filas */
        border-left: 1px solid #ddd;
        border-right: 1px solid #ddd;
        border-radius: 15px; /* Radio de borde para las celdas */
    }
    /*.tbl-users-head {
        border-radius: 30px;
        align-self: center;
        height:auto;
        width: 80%;
        background: #3c3d44;
        color: white;
    }
    .tbl-body-usersP {
        background: #fafafa;
        border-radius: 30px;
        min-height: 100px;
    }*/
    /* Estilo para la tabla con bordes redondeados */

    table {
        border-collapse: collapse;
        width: 80%;
        margin: 20px auto; /* Centrar la tabla en la página */
        border-radius: 10px; /* Radio de borde para la tabla */
        overflow: hidden; /* Ocultar contenido que exceda el radio de borde */
    }




    /* Estilo para las celdas */

    td {
        padding: 8px;
        text-align: left;
        border-bottom: 1px solid #ddd; /* Borde inferior para las filas */
        border-left: 1px solid #ddd;
        border-right: 1px solid #ddd;
        border-radius: 15px; /* Radio de borde para las celdas */
    }

    thead {
        border-bottom: 3px solid #ddd;
        height: 5rem;
        border-radius: 20px;
    }




    /* Estilo para las cabeceras */

    th {
        background-color: #f2f2f2; /* Color de fondo para las cabeceras */
    }
    /*.Btnnn{
        margin-left:80px;
