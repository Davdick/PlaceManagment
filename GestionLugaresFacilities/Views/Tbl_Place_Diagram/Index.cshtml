 <!--modal-->
<div id="myModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Agregar</h2>
        <form id="formDiagram">
            <div class="form-group">
                <label for="id_area">Area</label>
                    @Html.DropDownList("id_area", null, htmlAttributes: new { @class = "form-control" })
            </div>
            <div class="form-group">
                @*@Html.LabelFor(model => model.id_subarea, "id_subarea", htmlAttributes: new { @class = "control-label col-md-2" })*@
                    <label for="id_subarea">Subarea</label>
                    @Html.DropDownList("id_subarea", null, htmlAttributes: new { @class = "form-control" })
                    @*@Html.ValidationMessageFor(model => model.id_subarea, "", new { @class = "text-danger" })*@
                
            </div>
            <div class="form-group">                  
                    <label for="piso_snorkel" class="control-label col-md-2">Piso o snorkel</label>
                    <input type="number" min="1" id="piso_snorkel" name="piso_snorkel" class="form-control" required/>
            </div>
            <div class="form-group">
                <label for="size_x">Dimensiones en Y</label>
                <input id="size_x" name="size_x" class="form-control" required/>
            </div>
            <div class="form-group">
                <label for="size_y">Dimensiones en X</label>
                <input id="size_y" name="size_y" class="form-control" required/>
            </div>
            <div class="form-group">
                <input id="data_info" name="data_info" class="form-control" type="hidden"/>
            </div>
            <input class="btn btn-success" type="submit" value="Crear" id="enviarFormulario" />
        </form>
        <br />
        <p>OR</p>
        @Html.ActionLink("Crear plantilla personalizada", "Create", "Tbl_Place_Diagram", new { @class = "btn btn-primary", @type = "button" })

    </div>
</div>

