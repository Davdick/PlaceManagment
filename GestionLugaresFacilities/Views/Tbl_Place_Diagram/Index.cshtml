@section Scripts {
   @Scripts.Render("~/bundles/jqueryval")
    <script>
    function dwnExcelAllData() {
        //let actionLink = "/Tbl_Place_Diagram/DownloadExcelAll/";
        let actionLink = '@Url.Action("DownloadExcellAll", "Tbl_Place_Diagram")'
        window.location.href = actionLink;
    }
    function editLayout(id) {
        var url = '@Url.Action("editAdmin", "Tbl_Place_Diagram")?id=' + id;
        window.location.href = url;
    }
    function deleteLayout(id) {
       var url = '@Url.Action("Delete", "Tbl_Place_Diagram")?id=' + id;
        window.location.href = url;
    }
    function deleteLayout(id) {
       var url = '@Url.Action("Delete", "Tbl_Place_Diagram")?id=' + id;
        window.location.href = url;
    }
    function addLayout() {
       var url = '@Url.Action("Create", "Tbl_Place_Diagram")';
        window.location.href = url;
    }
    function showModal() {
        $('#myModal').show();
    }
    $('.close').on('click', function () {
        $('#myModal').hide();
    });
    $(window).on('click', function (event) {
        if (event.target.id === 'myModal') {
            $('#myModal').hide();
        }
        });
        //validar si el area es diferente a planta manufactura deshabilitar la subarea
        $('#id_area').change(function () {
            var selectedOption = $(this).val();
            if (selectedOption != '1') {
                $('#id_subarea').prop('disabled', true);
            } else {
                $('#id_subarea').prop('disabled', false);
            }
        });

        //enviar POST
        $('#formDiagram').submit(function (event) {
            event.preventDefault();

            var idSubareaSelect = $("#id_subarea");
            // Establecer el valor de id_subarea en null antes de enviar el formulario
            if (idSubareaSelect.prop("disabled")) {
                idSubareaSelect.val(null);
            }
            var list = [];
            let limitx = document.getElementById("size_x").value;
            let limity = document.getElementById("size_y").value;
           
            for (let i = 0; i < limitx; i++) {
                for (let j = 0; j < limity; j++) {
                    list.push({ x: i, y: j });
                }
            }
            console.log(list);
            list = JSON.stringify(list);
            document.getElementById("data_info").value = list;
            // Obtener los datos del formulario usando FormData
            var formData = new FormData(this);

            // Realizar la petición AJAX con los datos del formulario


            $.ajax({
                url: 'http://sagtdbw01/PlaceManagment/Tbl_Place_Assignment/JUAS/Tbl_Place_Diagram/Create',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    // Manejar la respuesta del servidor
                    //console.log('Respuesta del servidor:', response);
                    alert("Registrado!!");
                    location.reload();
                },
                error: function (error) {
                    // Manejar el error en caso de que ocurra
                    console.error('Error en la petición:', error);
                }
            });
        });

</script>
}

