<form id="formDiagram">
    <div class="form-group">
        @Html.LabelFor(model => model.id_area, "id_area", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownList("id_area", null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.id_area, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.id_subarea, "id_subarea", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownList("id_subarea", null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.id_subarea, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <label for="piso_snorkel" class="control-label col-md-2">Piso o snorkel</label>
        <div class="col-md-10">
            <input type="number" min="1" id="piso_snorkel" name="piso_snorkel" class="form-control" />
        </div>

    </div>
    <div class="form-group">
        <input type="hidden" id="size_x" name="size_x" />
    </div>
    <div class="form-group">
        <input type="hidden" id="size_y" name="size_y" />
    </div>
    <div class="form-group">
        <input type="hidden" id="data_info" name="data_info" />
    </div>
    <input class="btn btn-info" type="submit" value="Enviar" id="enviarFormulario" />
</form>


