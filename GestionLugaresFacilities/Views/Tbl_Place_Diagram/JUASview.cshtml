        function mostrarCargando() {
            // Bloquear la página y mostrar el cursor de carga
            $("body").addClass("loading");
        }


        ///GET USERS ID

        // Capturar el campo de entrada
    var $searchInput = $('#search-input');
    // Obtener el elemento select
    var $select = $('#id_user');

    // Evento para detectar cambios en el campo de entrada
    $searchInput.on('input', function () {
        var query = $(this).val(); // Obtener el valor ingresado por el usuario
        // Obtener datos desde el controlador y cargarlos en el select
        $.ajax({
            url: '@Url.Action("GetUserList", "Tbl_Place_Assignment")',
            type: 'GET',
            dataType: 'json',
            data: {
                txt: query  // Pasar el valor ingresado por el usuario como parámetro
            },
            success: function (data) {
                // Limpiar opciones existentes
                $select.empty();

                // Agregar las nuevas opciones desde los datos recibidos
                $.each(data, function (index, item) {
                    $select.append($('<option>', {
                        value: item.Value,
                        text: item.Text
                    }));
                });
            },
            error: function (error) {
                console.error('Error al obtener datos desde el servidor:', error);
            }
        });

        });
        /////////////////////////////////////////////////////////

        function addRequest() {

            // Mostrar la modal
            $('#myModal2').show();

            let dataCOORD = $(this).attr('data-coord');
            dataCOORD = JSON.parse(dataCOORD);
            dataCOORD = JSON.stringify(dataCOORD);
            console.log('data coord select', dataCOORD);
            console.log('id diagram', id_diagram);
            let id = $(this).attr('idcode');
            console.log("value", id);
            $('#idcode1').val(id);
            getIdCode(dataCOORD, id_diagram);
        }
        function getIdCode(data, id) {
            var $select = $('#id_code');
             $.ajax({
            url: '@Url.Action("GetCodeList", "Tbl_Place_Code")',
            type: 'GET',
            dataType: 'json',
            data: {
                id_d: id,
                d_coord: data
            },
            success: function (data) {
                console.log('Respuesta del servidor ID code:', data);
                if (data.length > 0) {
                    // Si recibes datos, selecciona el primer objeto y obtén su valor
                    var value = data[0].Value;
                    // Asigna el valor al elemento select
                    $select.val(value);
                }
            },
            error: function (error) {
                console.error('Error en la petición:', error);
            }
    });
    }

