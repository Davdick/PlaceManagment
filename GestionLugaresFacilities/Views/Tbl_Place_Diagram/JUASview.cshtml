<br />
<section class="titlesDiagram">
    <div class="titlesDiagram-titles">
        <div>
            <label for="disponibles">Area:</label>
            <p>@Model.Tbl_Place_Area_.name_area</p>
        </div>
        <div>
            <label for="noDisponibles">Subarea:</label>
            <p>@ViewBag.subarea</p> 
        </div>
        <div>
            <label for="total">Piso o snorkel:</label>
            <p>@Model.piso_snorkel</p>
        </div>
       
    </div>

    <div class="info-diagram">
        <div>
            <label for="disponibles">Lugares disponibles:</label>
            <input type="text" size="2" id="disponibles" disabled /> |
        </div>
        <div>
            <label for="noDisponibles">Lugares ocupados:</label>
            <input type="text" size="2" id="noDisponibles" disabled /> |
        </div>
        <div>
            <label for="total">Lugares totales:</label>
            <input type="text" size="2" id="total" disabled />
        </div>
       
    </div>
</section>

<p>
    <br />
    <a class="btn btn-info" href="/">Regresar</a>
    @if (ViewBag.subarea != "NA")
    {
        @Html.ActionLink("Ver lista de empleados", "Index", "Tbl_Place_Assignment", new { area = ViewBag.area, subarea = ViewBag.subarea, piso_snk = ViewBag.piso_snk}, new { @class = "btn btn-info" })
    }
    else
    {
        @Html.ActionLink("Ver lista de empleados", "Index", "Tbl_Place_Assignment", new { area = ViewBag.area, piso_snk = ViewBag.piso_snk, @class = "btn btn-info" }, new { @class = "btn btn-info" })
    }
    <br />

</p>
<div>
    <img src="~/Content/mapaPlanta.png" />
</div>
<br />
<table class="tblView">

    @for (int i = 0; i < @ViewBag.size_x; i++)
    {


        <tr>
            @for (int j = 0; j < @ViewBag.size_y; j++)
                {
                @*<td data-coord="{x:@i, y:@j}">X: i  Y:@j</td>*@
                <td data-coord="@(String.Format("{{\"x\":{0}, \"y\":{1}}}",i,j))"></td>
            }


        </tr>
    }
</table>
<!-- modal -->
<div id="myModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Usuario</h2>
        <div class="container-datas">
            <div>
                <label for="code">Codigo</label>
                <input id="code" type="text" disabled />

                <label for="place">Lugar</label>
                <input id="place" type="text" disabled />

                <label for="codechair">Codigo de silla</label>
                <input id="codechair" type="text" disabled />
            </div>
            <div>
                <label for="idemp">ID empleado</label>
                <input id="idemp" type="text" disabled />

                <label for="nemp">Nombre empleado</label>
                <input id="nemp" type="text" disabled />

                <label for="lastn">Apellido</label>
                <input id="lastn" type="text" disabled />
            </div>
            <div>
                <label for="ibt">IBT</label>
                <input id="ibt" type="text" disabled />

                <label for="email">Email</label>
                <input id="email" type="text" disabled />

                <label for="position">Posicion</label>
                <input id="position" type="text" disabled />

                <label for="sup">Supervisor</label>
                <input id="sup" type="text" disabled />

            </div>
            <div>
                <img width="100" class="img-responsive img-rounded" id="imagenApi" src="" alt="Imagen desde API">
            </div>

        </div>




    </div>
</div>
