    $('#formDiagramUser').submit(function (event) {
    event.preventDefault();
    mostrarCargando(); // Mostrar el estado de carga

    @*$('#id_').val(@Model.id_diagram);
    $('#data_coord').val(dataCOORD);*@


    // Obtener los datos del formulario usando FormData
   var formData = new FormData(this);

    //let idcodes1 = document.getElementById('idcode1').value;
    //let iduser = document.getElementById('id_user').value;
    //var formData = {
    //    id_user: idcodes1,
    //    id_user: iduser
    //}
    console.log(formData);
    // Realizar la petición AJAX con los datos del formulario
    $.ajax({
        url: '@Url.Action("Create", "Tbl_Place_AssignmentRequests")',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (response) {
            // Manejar la respuesta del servidor
            console.log('Respuesta del servidor:', response);
            alert("Peticion enviada!");
            $("body").removeClass("loading");
            $('#myModal2').hide();
            // Limpiar los inputs después de enviar el formulario
            $('#formDiagramUser').trigger("reset");

            location.reload();
        },
        error: function (error) {
            // Manejar el error en caso de que ocurra
            console.error('Error en la petición:', error);
            alert("Error! Intenta nuevamente");
            $("body").removeClass("loading");
        }
    });
    });



