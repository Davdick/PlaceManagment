                    document.getElementById('noDisponibles').value = inUse;
                    disponible = resDatac.length - inUse;
                    document.getElementById("disponibles").value = disponible;
                    document.getElementById('total').value = disponible + inUse;
                    paintUsers(data);

                },
                error: function () {
                    alert('Error while fetching data');
