//enviar POST
$('#formDiagram').submit(function (event) {
    event.preventDefault();
    mostrarCargando(); // Mostrar el estado de carga

    //parsear a json para tener un formato correcto
    coordajx = JSON.parse(coordajx);
    //parsear a string para guardar en bd
    coordajx = JSON.stringify(coordajx);
    let date = dateNow();
    $('#id_diagram').val(@Model.id_diagram);
    $('#data_coord').val(coordajx);
    $('#date_time').val(date);
    // Obtener los datos del formulario usando FormData
    var formData = new FormData(this);

    // Realizar la petición AJAX con los datos del formulario
    $.ajax({
        url: '@Url.Action("Create", "Tbl_Place_Code")',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (response) {
            // Manejar la respuesta del servidor
            console.log('Respuesta del servidor:', response);
            alert("Registrado!");
            $('#myModal').hide();
            // Limpiar los inputs después de enviar el formulario
            $('#formDiagram').trigger("reset");
            $("body").removeClass("loading");
            location.reload();
