        function addAutoCodes(area, subarea, fl_snk, i) {
            var autoCode;
            switch (area){
                case 'Central Building 1':
                    autoCode = "CB1" + "-" + "F" + fl_snk + "-" + i;
                    break;
                case 'Central Building 2':
                    autoCode = "CB2" + "-" + "F" + fl_snk + "-" + i;
                    break;
                case 'Planta Manufactura AGS':
