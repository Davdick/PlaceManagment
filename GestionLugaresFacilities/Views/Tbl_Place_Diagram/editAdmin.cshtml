@model GestionLugaresFacilities.Models.Tbl_Place_Diagram

@{
    ViewBag.Title = "Edit";
}

<link rel="stylesheet" href="~/Content/btnBack.css" />
<link rel="stylesheet" href="~/Content/btnDownload.css" />

<div>
    <hr />
    @if (ViewBag.back != false & ViewBag.backTicket ==false)
    {
        @*@Html.ActionLink("Regresar", "Index", new { area = Model.Area.name_area, subarea = Model.Subarea.name_subarea, piso_snk = Model.piso_snorkel }, null)*@
        <button class="btn-back" onclick="backDiagramsIndex()">
            <svg height="16" width="16" xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 1024 1024"><path d="M874.690416 495.52477c0 11.2973-9.168824 20.466124-20.466124 20.466124l-604.773963 0 188.083679 188.083679c7.992021 7.992021 7.992021 20.947078 0 28.939099-4.001127 3.990894-9.240455 5.996574-14.46955 5.996574-5.239328 0-10.478655-1.995447-14.479783-5.996574l-223.00912-223.00912c-3.837398-3.837398-5.996574-9.046027-5.996574-14.46955 0-5.433756 2.159176-10.632151 5.996574-14.46955l223.019353-223.029586c7.992021-7.992021 20.957311-7.992021 28.949332 0 7.992021 8.002254 7.992021 20.957311 0 28.949332l-188.073446 188.073446 604.753497 0C865.521592 475.058646 874.690416 484.217237 874.690416 495.52477z"></path></svg>
            <span>Regresar</span>
        </button>
    }
    else
    {
        
       if (ViewBag.subarea != "NA")
       {
        @Html.ActionLink("Ver lista de empleados", "Index", "Tbl_Place_Assignment", new { area = ViewBag.area, subarea = ViewBag.subarea, piso_snk = ViewBag.piso_snk }, new { @class = "btn btn-primary" })
       }
       else
       {
        @Html.ActionLink("Ver lista de empleados", "Index", "Tbl_Place_Assignment", new { area = ViewBag.area, piso_snk = ViewBag.piso_snk, @class = "btn btn-info" }, new { @class = "btn btn-primary" })
       }
        <br />
    }
    @if (ViewBag.backTicket != false)
    {   
        <br />
        @Html.ActionLink("Regresar", "Index", "Tbl_Place_Assignment", new { area = ViewBag.area, piso_snk = ViewBag.piso_snk, @class = "btn btn-info" }, new { @class = "btn btn-info" })
        <br />
    }
    <br />

    <section class="titlesDiagram">
        <div class="titlesDiagram-titles">
            <div>
                <label for="disponibles">Area:</label>
                <p>@Model.Tbl_Place_Area_.name_area</p>
            </div>
            <div>
                <label for="noDisponibles">Subarea:</label>
                <p>@ViewBag.subarea</p>
            </div>
            <div>
                <label for="total">Piso o snorkel:</label>
                <p>@Model.piso_snorkel</p>
            </div>

        </div>

        <div class="info-diagram">
            <div>
                <label for="disponibles">Lugares disponibles:</label>
                <input type="text" size="2" id="disponibles" disabled /> |
            </div>
            <div>
                <label for="noDisponibles">Lugares ocupados:</label>
                <input type="text" size="2" id="noDisponibles" disabled /> |
            </div>
            <div>
                <label for="total">Lugares totales:</label>
                <input type="text" size="2" id="total" disabled />
            </div>

        </div>
    </section>

    <br />

    <div class="row">
        @*<button class="btn btn-info" onclick="addRow()">Agregar fila</button>
            <button class="btn btn-info" onclick="addCol()">Agregar columna</button>*@
        
        @if (Settings.LoggedUser.Rol == 1 || Settings.LoggedUser.Rol == 2)
        {
            <div class="col-md-4">
                <button class="btnjk" onclick="dwnExcel()">
                    <span class="button__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 35 35" id="bdd05811-e15d-428c-bb53-8661459f9307" data-name="Layer 2" class="svg"><path d="M17.5,22.131a1.249,1.249,0,0,1-1.25-1.25V2.187a1.25,1.25,0,0,1,2.5,0V20.881A1.25,1.25,0,0,1,17.5,22.131Z"></path><path d="M17.5,22.693a3.189,3.189,0,0,1-2.262-.936L8.487,15.006a1.249,1.249,0,0,1,1.767-1.767l6.751,6.751a.7.7,0,0,0,.99,0l6.751-6.751a1.25,1.25,0,0,1,1.768,1.767l-6.752,6.751A3.191,3.191,0,0,1,17.5,22.693Z"></path><path d="M31.436,34.063H3.564A3.318,3.318,0,0,1,.25,30.749V22.011a1.25,1.25,0,0,1,2.5,0v8.738a.815.815,0,0,0,.814.814H31.436a.815.815,0,0,0,.814-.814V22.011a1.25,1.25,0,1,1,2.5,0v8.738A3.318,3.318,0,0,1,31.436,34.063Z"></path></svg></span>
                    Descargar excel
                </button>
            </div>
            <div class="col-md-4">
                <button type="button" class="btn btn-primary" onclick="addRow()">Agregar fila</button>
            </div>
            <div class="col-md-4">
                <button type="button" class="btn btn-primary" onclick="addCol()">Agregar columna</button>
            </div>
        }
       
        

    </div>
    <h2>Mapa</h2>
    <!-- modal codes -->
    @if (Settings.LoggedUser.Rol == 1 || Settings.LoggedUser.Rol == 2)
    {
        <div id="myModal" class="modal">
            <div class="modal-content">
                <span class="close">&times;</span>
                <h2>Agregar codigo</h2>
                <form id="formDiagram">
                    <div class="form-group">
                        <input type="hidden" id="id_diagram" name="id_diagram" />
                    </div>
                    <div class="form-group">
                        <input type="hidden" id="data_coord" name="data_coord" />
                    </div>
                    <div class="form-group">
                        <label for="code1">Codigo</label>
                        <input type="text" id="code1" name="code" required />
                    </div>
                    <div class="form-group">
                        <input type="hidden" id="data_time" name="data_time" />
                    </div>
                    <div class="form-group">
                        <label for="type_place">Tipo lugar</label>
                        @*<input type="text" id="type_place" name="type_place" />*@
                        <select class="form-control" id="type_place" name="type_place">
                            <option value="">Selecciona una opción</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="chair_code">Codigo silla</label>
                        <input type="text" id="chair_code" name="chair_code" required />
                    </div>
                    <input class="btn btn-success" type="submit" value="Guardar" id="enviarFormulario" />

                </form>
                <br />
                @if (Settings.LoggedUser.Rol == 1 || Settings.LoggedUser.Rol == 2)
                {
                    <button class="btn btn-danger" id="btn-remove-cell" onclick="deleteCell()">Eliminar area</button>
                }


            </div>
        </div>
    }

    <!-- modal assignment -->
    <div id="myModal2" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            @if (Settings.LoggedUser.Rol == 1 || Settings.LoggedUser.Rol == 2)
            {
                <h2>Agregar empleado</h2>
                <input id="show-code-emp" type="text" disabled />
                <br />
                <button class="btn btn-primary" onclick="editCode()">Editar</button> 
                <button class="btn btn-danger" onclick="deleteCode()">Deshabilitar</button>
                <br />
            }
            else
            {
                <h2>Ticket place</h2>
            }
            @{
                string form = "formDiagramUser";
                if (Settings.LoggedUser.Rol == 1 || Settings.LoggedUser.Rol == 2)
                {
                     form = "formDiagramAdmin";
                }
                


            }

            <form id="@form">
                <div>
                    <input type="hidden" id="idcode1" name="id_code" />
                    <label for="search-input">ID empleado</label>
                    <div class="col-md-10">
                        <!-- Agrega un campo de entrada para que el usuario pueda escribir su consulta -->
                        <input type="text" id="search-input" placeholder="Consulta id" required>
                        <!-- Agrega el elemento select donde se cargarán las opciones -->
                        <select class="form-control" id="id_user" name="id_user"></select>
                    </div>
                    <br />
                </div>
               
                @if (Settings.LoggedUser.Rol == 1 || Settings.LoggedUser.Rol == 2)
                {
                    <br />
                    <input type="submit" class="btn btn-success" value="Agregar" id="enviarFormularioUser" />
                }
                else
                {
                    <input type="submit" class="btn btn-success" value="Enviar" id="enviarFormularioUser" />
                }

            </form>
        </div>
    </div>
    <!--modal users-->
    <div id="myModalUsers" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Usuario</h2>
            @if (Settings.LoggedUser.Rol == 1 || Settings.LoggedUser.Rol == 2)
            {
                <button class="btn btn-danger" onclick="deleteAssing()">Quitar empleado</button>
            }
            
            <div class="container-datas">
                <div>
                    <input type="hidden" id="idassign" />
                    <label for="code">Codigo</label>
                    <input id="code" type="text" disabled />

                    <label for="place">Lugar</label>
                    <input id="place" type="text" disabled />

                    <label for="codechair">Codigo de silla</label>
                    <input id="codechair" type="text" disabled />
                </div>
                <div>
                    <label for="idemp">ID empleado</label>
                    <input id="idemp" type="text" disabled />

                    <label for="nemp">Nombre empleado</label>
                    <input id="nemp" type="text" disabled />

                    @*<label for="lastn">Apellido</label>
                    <input id="lastn" type="text" disabled />*@
                </div>
                <div>
                    <label for="ibt">IBT</label>
                    <input id="ibt" type="text" disabled />

                    <label for="email">Email</label>
                    <input id="email" type="text" disabled />

                    @*<label for="position">Posicion</label>
                    <input id="position" type="text" disabled />*@

                    <label for="sup">Supervisor</label>
                    <input id="sup" type="text" disabled />

                </div>
                <div>
                    <img width="100" class="img-responsive img-rounded" id="imagenApi" src="" alt="Imagen desde API">
                </div>

            </div>




        </div>
    </div>
    @*<div>
        <img src="~/Content/mapaPlanta.png" />
    </div>*@
    <br />
    <div class="table-responsive row">
        <div class="col-md-4"></div>
        <div class="col-md-4"style="display:none;" id="loadingtable">
            <img src="~/Content/load-34_256.gif"/>
        </div>
        <div class="col-md-4"></div>
        <table id="tableDiagram"class="tblView">
            @for (int i = 0; i < @ViewBag.size_x; i++)
            {


                <tr>
                    @for (int j = 0; j < @ViewBag.size_y; j++)
                {
                        @*<td data-coord="{x:@i, y:@j}">X: i  Y:@j</td>*@
                        <td data-coord="@(String.Format("{{\"x\":{0}, \"y\":{1}}}",i,j))"></td>
                    }


                </tr>
            }
        </table>
    </div>
    
</div>



