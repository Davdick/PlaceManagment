<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>||</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    @if (ViewBag.Alert != null)
    {
        <script>
                alert("@ViewBag.Alert");
        </script>
    }

    <div class="navbar navbar-inverse navbar-fixed-top">
        
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                
                @Html.ActionLink("Gestion de lugares", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    @*<li>@Html.ActionLink("Home", "Index", "Home")</li>*@
              

                    <li>
                        <div class="inputboxx">
                            <input required="required" type="text" id="find-code" onkeypress="dofn(event)">
                            <span>Id empleado o lugar</span>
                            <i></i>
                        </div>
                    </li>
                    <li>
                        @*<button class="btn btn-success" onclick="searchDiagram()">Buscar</button>*@
                        <button class="search__btn" onclick="searchDiagram()">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22">
                                <path d="M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247L16.0247 15.8748Z" fill="#efeff1"></path>
                            </svg>
                        </button>
                    </li>

                    @*<li><input id="find-code" type="text" placeholder="Buscar por ID" /><button class="btn btn-success" onclick="searchDiagram()">Buscar</button></li>*@
                    <li>@Html.ActionLink("Ver mi lugar","editAdmin", "Tbl_Place_Diagram", new { code = Settings.LoggedUser.User.id_employee }, null)</li>
                    
                    @if (Settings.LoggedUser.Rol == 1 || Settings.LoggedUser.Rol == 2)
                    {
                        <li>@Html.ActionLink("Catalogos", "About", "Home")</li>
                        <li>@Html.ActionLink("Layout", "Index", "Tbl_Place_Diagram")</li>
                    }
                    <li>@Html.ActionLink("About", "Abt", "Home")</li>
                    <li>@Html.ActionLink("Cerrar sesion", "LogOut", "Home")</li>

                </ul>
            </div>
        </div>
    </div>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Sensata Technologies</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)




</body>
</html>
<script>

    function dofn(e) {
        if (e.key === 'Enter') {
            // Llama a la función que deseas ejecutar al presionar Enter
            searchDiagram();
        }
    }
     function searchDiagram() {
        let code = document.getElementById('find-code').value;
        if (code != null && code!= "" && code.length >= 8 && code.length<12){
            var url = '@Url.Action("editAdmin", "Tbl_Place_Diagram")?code='+code;
            //$('#partial-view-layout').load(url);
            window.location.href = url;
        } else {
            alert("codigo erroneo");
        }
    }
    //console.log("user", @Settings.LoggedUser.User.id_employee)
</script>

<style>
    body {
        border-radius: 45px;
        background: #EFEFEF;
        box-shadow: 15px 15px 90px #232624, -15px -15px 90px #8b9a90;
    }
    /* Asegúrate de que este estilo esté en tu archivo de estilos CSS */
    .navbar-nav li:last-child {
        display:flex;
        align-self:flex-end;
    }

</style>
