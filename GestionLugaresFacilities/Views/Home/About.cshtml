@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        showRequests();
        var templateLoading = `
              <div class="wrapper">
    <div class="circle"></div>
    <div class="circle"></div>
    <div class="circle"></div>
    <div class="shadow"></div>
    <div class="shadow"></div>
    <div class="shadow"></div>
</div>
        `;
        var templateSearchUser = `<br/><div id="scemp">
        <label for="inpt-codemp">Buscar por codigo</label>
        <input id="inpt-codemp" class="inpt-btn" type="text" placeholder="X123456789" />
        <button class="btn-search btn-primary"  onclick="btnsearch()">Buscar</button>
    </div>`;
        function showUsers() {
            let url = '@Url.Action("UsersPartial", "Tbl_Place_Users")';
            $('#partial-view').html(templateLoading);
            $('#partial-view').load(url);
            //$('#scemp').show();
        }
         function showSearchUser() {
            let url = '@Url.Action("UsersPartial", "Tbl_Place_Users")';
            $('#partial-view').html(templateSearchUser);
            //$('#partial-view').load(url);
            //$('#scemp').show();
        }
       function showAreas() {
           let url = '@Url.Action("AreasPartial", "Tbl_Place_Area_")';
           $('#scemp').hide();
           $('#partial-view').html(templateLoading);
            $('#partial-view').load(url);
        }
        function showSubareas() {
            $('#scemp').hide();
            $('#partial-view').html(templateLoading);
            let url ='@Url.Action("SubareasPartialView", "Tbl_Place_Subarea")';
            $('#partial-view').load(url);
        }
        function btnsearch() {
            let val = document.getElementById("inpt-codemp").value;
            $('#partial-view').html(templateLoading);
            var url = '@Url.Action("UsersPartialSpecific", "Tbl_Place_Users")?code=' + val;
            $('#partial-view').load(url);
        }
        function showRequests() {
            $('#scemp').hide();
            $('#partial-view').html(templateLoading);
            let url ='@Url.Action("PartialIndex", "Tbl_Place_AssignmentRequests")';
            $('#partial-view').load(url);
        }
          ///USER PARTIAL
    function addUserPartial() {
         var url = '@Url.Action("Create", "Tbl_Place_Users")';
        window.location.href = url;
        }
    function editUserPartial(id) {
         var url = '@Url.Action("Edit", "Tbl_Place_Users")?id=' + id;
        window.location.href = url;
        }
    function deleteUserPartial(id) {
         var url = '@Url.Action("Delete", "Tbl_Place_Users")?id=' + id;
        window.location.href = url;
        }
        //AREAS PARTIAL
            function addAreaPartial() {
         var url = '@Url.Action("Create", "Tbl_Place_Area_")';
        window.location.href = url;
        }
    function editAreaPartial(id) {
         var url = '@Url.Action("Edit", "Tbl_Place_Area_")?id=' + id;
        window.location.href = url;
        }
    function deleteAreaPartial(id) {
         var url = '@Url.Action("Delete", "Tbl_Place_Area_")?id=' + id;
        window.location.href = url;
        }
             //SUBAREAS PARTIAL
    function addSubPartial() {
         var url = '@Url.Action("Create", "Tbl_Place_Subarea")';
        window.location.href = url;
        }
    function editSubPartial(id) {
         var url = '@Url.Action("Edit", "Tbl_Place_Subarea")?id=' + id;
        window.location.href = url;
        }
    function deleteSubPartial(id) {
         var url = '@Url.Action("Delete", "Tbl_Place_Subarea")?id=' + id;
        window.location.href = url;
        }
           //REQUESTS PARTIAL

    function viewPartial(id) {
         var url = '@Url.Action("Edit", "Tbl_Place_Subareas")?id=' + id;
        window.location.href = url;
        }
    function deletePartial(id) {
         var url = '@Url.Action("Delete", "Tbl_Place_AssignmentRequests")?id=' + id;
        window.location.href = url;
        }
         function modalInfo(id) {
        $('#myModalUsers').show();
       
         $.ajax({
            url: '@Url.Action("GetApiEmployee", "Tbl_Place_Users")',
            type: 'GET',
            dataType: 'json',
            data: {
                idEmp: id
            },
            success: function (data) {
            document.getElementById("idemp").value = data.EmployeeNumber;
            document.getElementById("nemp").value = data.EmployeeName;
            //document.getElementById("lastn").value = lastn;
            document.getElementById("ibt").value = data.IBT;
            document.getElementById("sup").value = data.SupervisorName;
           // document.getElementById("position").value = data.position;
            document.getElementById("email").value = data.EmployeeNumber+"@@sensata.com";
            var apiUrl = `http://mexico.corp.sensata.com/Utils/API/Employee/GetPhoto/${id} `;
            document.getElementById('imagenApi').src = apiUrl;
            },
            error: function (error) {
                console.error('Error al obtener datos desde el servidor:', error);
            }
        });
    }
    $('#close').on('click', function () {
        $('#myModalUsers').hide()
         });
        // Cerrar la modal cuando se hace clic fuera de la modal
        $(window).on('click', function (event) {
            if (event.target.id === 'myModalUsers') {
                $('#myModalUsers').hide();
            }
        });

///////////////////          POST A ASSIGNMENT                  //////////////////////
    function acceptRequest(idCode, idUser) {
        debugger;

            event.preventDefault();
   // mostrarCargando(); // Mostrar el estado de carga

            var formData = new FormData();
            formData.append('id_code', idCode);
            formData.append('id_user', idUser);

   // console.log(Data);
    // Realizar la petición AJAX con los datos del formulario
    $.ajax({
        url: '@Url.Action("Create", "Tbl_Place_Assignment")',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (response) {
            // Manejar la respuesta del servidor
            console.log('Respuesta del servidor:', response);
            alert("Registrado!");
            $("body").removeClass("loading");
            $('#myModal2').hide();
            // Limpiar los inputs después de enviar el formulario
            //$('#formDiagramUser').trigger("reset");

            location.reload();
        },
        error: function (error) {
            // Manejar el error en caso de que ocurra
            console.error('Error en la petición:', error);
            alert("Error! Intenta nuevamente");
            $("body").removeClass("loading");
        }
    });
        }


    </script>
}
